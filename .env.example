# Optional. Copy to .env to point the app at your own Supabase project.
# Without these, the app uses the live project's public values.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# The one address allowed to register for push notifications (see src/push.js)
VITE_PUSH_ORIGIN=http://localhost:5173
